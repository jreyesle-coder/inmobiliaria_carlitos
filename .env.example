# Supabase — copiar a .env.local y completar. NUNCA commitear .env.local
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo servidor. No exponer al navegador.
SUPABASE_SERVICE_ROLE_KEY=

# Conexión directa a Postgres para las migraciones de Drizzle y para
# `node scripts/sql.mjs`. En el panel: botón "Connect" de la barra superior >
# Session pooler (IPv4, puerto 5432). La del Transaction pooler (6543) no sirve
# para migraciones. Lleva la contraseña de la base de datos, no una llave.
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:CONTRASENA@aws-0-us-east-1.pooler.supabase.com:5432/postgres
